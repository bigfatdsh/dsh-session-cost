{
  "name": "dsh-session-cost",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "在对话的 token 用量旁显示本轮花费、在输入框下方显示本会话总花费（DeepSeek 官方峰谷价目表）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cost",
    "usage",
    "token",
    "pricing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigfatdsh/dsh-session-cost.git"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/config.js",
    "lib/pricing.js",
    "lib/schema.js",
    "lib/index.test.js",
    "client.js",
    "client.test.js",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test lib/index.test.js client.test.js",
    "pack": "pnpm pack"
  },
  "meta": {
    "title": "会话花费 Session Cost",
    "description": "把「这一轮花了多少钱」和「这个会话一共花了多少钱」直接显示在 token 用量旁边。"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
